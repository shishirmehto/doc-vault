# Copy to .env. Every value is optional: with no key the stack runs on the
# deterministic fake provider and GET /health reports "ai_mode": "fake".
OPENAI_API_KEY=
# auto = openai when a key is set, otherwise fake. openai without a key stops the service at start.
CHAT_PROVIDER=auto
EMBED_PROVIDER=auto
# Main tier (answers, insights) and small tier (follow-up question rewriting)
OPENAI_CHAT_MODEL=gpt-6.1-sol
OPENAI_SMALL_MODEL=gpt-6-luna
# none, minimal, low, medium, high, xhigh or max; each model accepts only part of that range
OPENAI_CHAT_REASONING_EFFORT=low
OPENAI_SMALL_REASONING_EFFORT=none
OPENAI_EMBED_MODEL=text-embedding-3-small
# Changing the model or the dimension makes reconcile re-embed every document
EMBED_DIMENSIONS=1536
# Provider attempts per chat call, and the first retry delay in seconds (doubles each retry).
# Background embedding and insights calls are retried by Celery instead.
AI_MAX_ATTEMPTS=3
AI_BACKOFF_S=0.5
# Per-client budgets for POST /documents and POST /chats/{id}/messages, per API process. Over budget: 429.
UPLOADS_PER_MINUTE=30
QUESTIONS_PER_MINUTE=20
# A daily AI spending cap in US dollars, counted from the ledger since midnight UTC. Once reached, questions,
# comparisons and summaries get 429 quota_exceeded until midnight UTC, and new insights fail; uploads, indexing
# and search keep working. Empty: no cap.
DAILY_AI_BUDGET_USD=
# A Redis for the embedding cache and the answer cache (a chat's first question, answered before on the same
# documents, comes back with no model call). Empty: no cache. Compose sets redis://cache:6379/0 on the api and
# worker, which overrides this file. The app runs the same when the cache is down, only without its savings.
CACHE_URL=
# Host port for the compose Postgres (tests connect here)
DB_PORT=54329
# Host port for the API
API_PORT=8000
